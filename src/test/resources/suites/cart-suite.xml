<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cart Tests - Cross Browser" parallel="tests" thread-count="3">

    <test name="Cart Tests - Chromium">
        <parameter name="browserType" value="chromium"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.dacresillvaant.playwright.tests.CartTests"/>
        </classes>
    </test>

    <test name="Cart Tests - Firefox">
        <parameter name="browserType" value="firefox"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.dacresillvaant.playwright.tests.CartTests"/>
        </classes>
    </test>

    <test name="Cart Tests - WebKit">
        <parameter name="browserType" value="webkit"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.dacresillvaant.playwright.tests.CartTests"/>
        </classes>
    </test>

</suite>