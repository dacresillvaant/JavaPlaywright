<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Login Tests - Cross Browser" parallel="tests" thread-count="3">

    <test name="Login Tests - Chromium">
        <parameter name="browserType" value="chromium"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.dacresillvaant.playwright.tests.LoginTests"/>
        </classes>
    </test>

    <test name="Login Tests - Firefox">
        <parameter name="browserType" value="firefox"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.dacresillvaant.playwright.tests.LoginTests"/>
        </classes>
    </test>

    <test name="Login Tests - WebKit">
        <parameter name="browserType" value="webkit"/>
        <parameter name="headless" value="false"/>
        <classes>
            <class name="com.dacresillvaant.playwright.tests.LoginTests"/>
        </classes>
    </test>

</suite>