<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Full Test Suite - Cross Browser" parallel="tests" thread-count="3">

    <test name="All Tests - Chromium" parallel="classes" thread-count="2">
        <parameter name="browserType" value="chromium"/>
        <parameter name="headless" value="true"/>
        <packages>
            <package name="com.dacresillvaant.playwright.tests.*"/>
        </packages>
    </test>

    <test name="All Tests - Firefox" parallel="classes" thread-count="2">
        <parameter name="browserType" value="firefox"/>
        <parameter name="headless" value="true"/>
        <packages>
            <package name="com.dacresillvaant.playwright.tests.*"/>
        </packages>
    </test>

    <test name="All Tests - WebKit" parallel="classes" thread-count="2">
        <parameter name="browserType" value="webkit"/>
        <parameter name="headless" value="true"/>
        <packages>
            <package name="com.dacresillvaant.playwright.tests.*"/>
        </packages>
    </test>

</suite>